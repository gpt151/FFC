# Lyt IT Pay 托管收款账号（用于创建收款链接及发放红包、结算手续费）
# 注意：如果托管账号本身就是 1218545105@qq.com，5%手续费将自动保留在该账户中；
# 如果是其他托管账号，收到付款后系统会自动调用 transfer 接口将 5% 手续费转账至 FEE_RECIPIENT_EMAIL
LYT_MERCHANT_EMAIL=1218545105@qq.com
LYT_MERCHANT_PASSWORD=Gpt15183056898

# 平台手续费配置（默认 5% 到 1218545105@qq.com）
FEE_RECIPIENT_EMAIL=1218545105@qq.com
FEE_RATE=0.05
# sender_pays: 外扣模式（例：发100元红包，额外付5元手续费，共付105元，领取总额100元）
# deduct_from_packet: 内扣模式（例：共付100元，扣除5元手续费，领取总额95元）
FEE_MODE=sender_pays

# 管理后台密码 & 会话签名密钥（部署到 Vercel 务必设置强密码！）
ADMIN_PASSWORD=Gpt15183056898
SESSION_SECRET=replace-with-a-random-32-char-secret-key

# 数据库连接字符串（Vercel 部署推荐接入 Neon / Supabase / Vercel Postgres）
# 支持 DATABASE_URL 或 POSTGRES_URL；本地开发留空会自动使用 .data/store.json
DATABASE_URL=

# 站点公开访问地址（用于生成分享链接与 OAuth 回调地址，Vercel 部署可留空自动识别）
NEXT_PUBLIC_BASE_URL=
LYT_API_BASE_URL=https://pay.teft.us
